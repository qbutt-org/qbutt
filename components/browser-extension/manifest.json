{
    "manifest_version": 3,
    "name": "qbutt Browser Connection",
    "version": "1.0.0",
    "description": "Connect browser sessions and selected video players to qbutt.",
    "key": "",
    "permissions": ["cookies", "nativeMessaging", "tabs", "webRequest", "alarms"],
    "host_permissions": ["http://*/*", "https://*/*"],
    "background": { "service_worker": "background.js" },
    "content_scripts": [
        {
            "all_frames": true,
            "matches": ["http://*/*", "https://*/*"],
            "js": ["sniffer.js"],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "all_frames": true,
            "matches": ["http://*/*", "https://*/*"],
            "js": ["content.js"],
            "run_at": "document_start"
        }
    ]
}
