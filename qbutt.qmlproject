import QmlProject 1.1

Project {
    mainFile: "design/App.qml"
    mainUiFile: "design/SearchPreview.ui.qml"
    importPaths: ["design/mockimports"]
    qt6Project: true
    qdsVersion: "4.8"

    QmlFiles {
        directory: "design"
    }

    QmlFiles {
        directory: "src/gui/quick/qml"
    }

    ImageFiles {
        directory: "src/icons"
    }

    Files {
        directory: "design/mockimports"
        filter: "qmldir"
    }
}
